#!/usr/bin/env bash

set -euo pipefail

: "${CCC:?set CCC to the ccc executable}"
: "${CCC_RESOURCE_DIR:?set CCC_RESOURCE_DIR to the shipped resource directory}"
: "${CCC_LINK_CC:=gcc}"

export CCC_CC="$CCC_LINK_CC"

command -v "$CCC" >/dev/null 2>&1 || {
  echo "ccc-cc: CCC is not executable: $CCC" >&2
  exit 2
}
[[ -d "$CCC_RESOURCE_DIR" ]] || {
  echo "ccc-cc: resource directory does not exist: $CCC_RESOURCE_DIR" >&2
  exit 2
}
command -v "$CCC_LINK_CC" >/dev/null 2>&1 || {
  echo "ccc-cc: link driver is not executable: $CCC_LINK_CC" >&2
  exit 2
}

log_command() {
  if [[ -z "${CCC_ZSTD_COMMAND_LOG:-}" ]]; then
    return
  fi
  local line=$1
  local argument rendered
  shift
  for argument in "$@"; do
    printf -v rendered '%q' "$argument"
    line+=" $rendered"
  done
  printf '%s\n' "$line" >>"$CCC_ZSTD_COMMAND_LOG"
}

record_source() {
  local source=$1
  local parent absolute root actual_probe_sha256
  [[ -f "$source" ]] || {
    echo "ccc-cc: C source does not exist: $source" >&2
    exit 2
  }
  parent=$(cd "$(dirname "$source")" && pwd -P)
  absolute="$parent/$(basename "$source")"
  if [[ -n "${CCC_ZSTD_SOURCE_ROOT:-}" ]]; then
    root=$(cd "$CCC_ZSTD_SOURCE_ROOT" && pwd -P)
    case "$absolute" in
      "$root"/*) ;;
      *)
        echo "ccc-cc: C source is outside the pinned zstd source directory: $absolute" >&2
        exit 2
        ;;
    esac
  fi
  if [[ -n "${CCC_ZSTD_SOURCE_LOG:-}" ]]; then
    printf '%s\n' "$absolute" >>"$CCC_ZSTD_SOURCE_LOG"
  fi
  if [[ -n "${CCC_ZSTD_PTHREAD_PROBE:-}" && "$absolute" == "$CCC_ZSTD_PTHREAD_PROBE" ]]; then
    : "${CCC_ZSTD_PTHREAD_PROBE_SHA256:?set the expected pthread probe SHA-256}"
    : "${CCC_ZSTD_PROBE_HASH_LOG:?set the generated-probe hash log}"
    command -v openssl >/dev/null 2>&1 || {
      echo "ccc-cc: openssl is required to audit the generated pthread probe" >&2
      exit 2
    }
    actual_probe_sha256=$(openssl dgst -sha256 "$absolute" | awk '{print $NF}')
    [[ "$actual_probe_sha256" == "$CCC_ZSTD_PTHREAD_PROBE_SHA256" ]] || {
      echo "ccc-cc: generated pthread probe does not match the pinned source" >&2
      exit 2
    }
    printf '%s  %s\n' "$actual_probe_sha256" "$absolute" >>"$CCC_ZSTD_PROBE_HASH_LOG"
  fi
}

run_ccc() {
  log_command ccc "$CCC" -resource-dir "$CCC_RESOURCE_DIR" "$@"
  "$CCC" -resource-dir "$CCC_RESOURCE_DIR" "$@"
}

run_linker() {
  log_command link "$CCC_LINK_CC" "$@"
  "$CCC_LINK_CC" "$@"
}

arguments=("$@")
sources=()
compile_arguments=()
output=
compile_only=false
frontend_only=false

for ((index = 0; index < ${#arguments[@]}; index++)); do
  argument=${arguments[index]}
  case "$argument" in
    *.c)
      sources+=("$argument")
      ;;
    -o)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: -o requires an argument" >&2
        exit 2
      fi
      output=${arguments[index + 1]}
      ((index += 1))
      ;;
    -MF | -MT | -MQ)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      fi
      compile_arguments+=("$argument" "${arguments[index + 1]}")
      ((index += 1))
      ;;
    -I | -iquote | -isystem | -idirafter | -isysroot)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      fi
      compile_arguments+=("$argument" "${arguments[index + 1]}")
      ((index += 1))
      ;;
    -c)
      compile_only=true
      ;;
    -E | -M | -MM | --dump-* | --emit=*)
      frontend_only=true
      compile_arguments+=("$argument")
      ;;
    -l?* | -L?* | -Wl,* | -pthread | -pie | -no-pie | -rdynamic)
      ;;
    -l | -L | -Xlinker | -z)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      fi
      ((index += 1))
      ;;
    *.o | *.a | *.so | *.lo)
      ;;
    *.s | *.S | *.asm)
      echo "ccc-cc: assembly input is outside the selected zstd C surface: $argument" >&2
      exit 2
      ;;
    *.i | *.ii)
      echo "ccc-cc: preprocessed source input is unsupported and will not be delegated: $argument" >&2
      exit 2
      ;;
    *.cc | *.cp | *.cpp | *.cxx | *.C | *.m | *.mm)
      echo "ccc-cc: non-C source input is outside the selected zstd C surface: $argument" >&2
      exit 2
      ;;
    -S)
      echo "ccc-cc: assembly output is outside the selected zstd C surface" >&2
      exit 2
      ;;
    -Wa,* | -Xassembler)
      echo "ccc-cc: assembler options are outside the selected zstd C surface: $argument" >&2
      exit 2
      ;;
    -x)
      echo "ccc-cc: explicit language selection is unsupported and will not be delegated" >&2
      exit 2
      ;;
    @*)
      echo "ccc-cc: response files are unsupported because their C inputs cannot be audited" >&2
      exit 2
      ;;
    *)
      compile_arguments+=("$argument")
      ;;
  esac
done

if ((${#sources[@]} == 0)); then
  if ((${#arguments[@]} == 1)); then
    case "${arguments[0]}" in
      --version | -v)
        printf 'ccc zstd corpus adapter (C translation by %s; linking by %s)\n' \
          "$CCC" "$CCC_LINK_CC"
        exit 0
        ;;
      -dumpmachine)
        printf 'x86_64-unknown-linux-gnu\n'
        exit 0
        ;;
    esac
  fi
  run_linker "${arguments[@]}"
  exit $?
fi

if $frontend_only; then
  if ((${#sources[@]} != 1)); then
    echo "ccc-cc: frontend-only actions require exactly one C source" >&2
    exit 2
  fi
  run_ccc "${arguments[@]}"
  exit $?
fi

if $compile_only && [[ -n "$output" ]] && ((${#sources[@]} != 1)); then
  echo "ccc-cc: -o with -c requires exactly one C source" >&2
  exit 2
fi

object_directory=
if ! $compile_only; then
  object_directory=$(mktemp -d "${TMPDIR:-/tmp}/ccc-zstd-objects.XXXXXX")
  cleanup_object_directory() {
    if [[ -n "$object_directory" ]] && [[ -d "$object_directory" ]]; then
      rm -rf -- "$object_directory"
    fi
  }
  trap cleanup_object_directory EXIT
fi
objects=()

for ((index = 0; index < ${#sources[@]}; index++)); do
  source=${sources[index]}
  record_source "$source"
  if $compile_only; then
    if [[ -n "$output" ]]; then
      object=$output
    else
      object=$(basename "${source%.c}.o")
    fi
  else
    object="$object_directory/$index.o"
  fi
  if ((${#compile_arguments[@]})); then
    run_ccc "${compile_arguments[@]}" -c "$source" -o "$object"
  else
    run_ccc -c "$source" -o "$object"
  fi
  objects+=("$object")
done

if $compile_only; then
  exit 0
fi

link_arguments=()
source_index=0
for ((index = 0; index < ${#arguments[@]}; index++)); do
  argument=${arguments[index]}
  case "$argument" in
    *.c)
      link_arguments+=("${objects[source_index]}")
      ((source_index += 1))
      ;;
    -include | -imacros)
      ((index + 1 < ${#arguments[@]})) || {
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      }
      ((index += 1))
      ;;
    -MF | -MT | -MQ)
      ((index + 1 < ${#arguments[@]})) || {
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      }
      ((index += 1))
      ;;
    -M | -MM | -MD | -MMD | -MP)
      ;;
    -I | -iquote | -isystem | -idirafter | -isysroot)
      ((index + 1 < ${#arguments[@]})) || {
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      }
      ((index += 1))
      ;;
    -I?*)
      ;;
    *)
      link_arguments+=("$argument")
      ;;
  esac
done
run_linker "${link_arguments[@]}"
