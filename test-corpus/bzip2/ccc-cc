#!/usr/bin/env bash

set -euo pipefail

script_directory=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$script_directory/../adapter-environment.sh"

: "${CCC:?set CCC to the ccc executable}"
: "${CCC_RESOURCE_DIR:?set CCC_RESOURCE_DIR to the shipped resource directory}"
: "${CCC_LINK_CC:?set CCC_LINK_CC to the selected target link driver}"
: "${CCC_BZIP2_TARGET:?set CCC_BZIP2_TARGET to the selected target triple}"

case "$CCC_BZIP2_TARGET" in
  x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | \
    riscv64-unknown-linux-gnu)
    : "${CCC_BZIP2_SYSROOT:?set CCC_BZIP2_SYSROOT to the compiler sysroot}"
    [[ -d "$CCC_BZIP2_SYSROOT" ]] || {
      echo "ccc-cc: compiler sysroot does not exist: $CCC_BZIP2_SYSROOT" >&2
      exit 2
    }
    ;;
  aarch64-apple-darwin)
    : "${CCC_BZIP2_SDKROOT:?set CCC_BZIP2_SDKROOT to the macOS SDK}"
    : "${CCC_BZIP2_DEPLOYMENT_TARGET:?set CCC_BZIP2_DEPLOYMENT_TARGET}"
    [[ -d "$CCC_BZIP2_SDKROOT" ]] || {
      echo "ccc-cc: macOS SDK does not exist: $CCC_BZIP2_SDKROOT" >&2
      exit 2
    }
    ;;
  *)
    echo "ccc-cc: unsupported target: $CCC_BZIP2_TARGET" >&2
    exit 2
    ;;
esac

export CCC_CC="$CCC_LINK_CC"

command -v "$CCC" >/dev/null 2>&1 || {
  echo "ccc-cc: CCC is not executable: $CCC" >&2
  exit 2
}
[[ -d "$CCC_RESOURCE_DIR" ]] || {
  echo "ccc-cc: resource directory does not exist: $CCC_RESOURCE_DIR" >&2
  exit 2
}
command -v "$CCC_LINK_CC" >/dev/null 2>&1 || {
  echo "ccc-cc: link driver is not executable: $CCC_LINK_CC" >&2
  exit 2
}

log_command() {
  if [[ -z "${CCC_BZIP2_COMMAND_LOG:-}" ]]; then
    return
  fi
  local line=$1
  local argument rendered
  shift
  for argument in "$@"; do
    printf -v rendered '%q' "$argument"
    line+=" $rendered"
  done
  printf '%s\n' "$line" >>"$CCC_BZIP2_COMMAND_LOG"
}

record_source() {
  local source=$1
  local parent absolute root
  [[ -f "$source" ]] || {
    echo "ccc-cc: C source does not exist: $source" >&2
    exit 2
  }
  parent=$(cd "$(dirname "$source")" && pwd -P)
  absolute="$parent/$(basename "$source")"
  if [[ -n "${CCC_BZIP2_SOURCE_ROOT:-}" ]]; then
    root=$(cd "$CCC_BZIP2_SOURCE_ROOT" && pwd -P)
    [[ "$parent" == "$root" ]] || {
      echo "ccc-cc: C source is outside the pinned bzip2 source directory: $absolute" >&2
      exit 2
    }
  fi
  if [[ -n "${CCC_BZIP2_SOURCE_LOG:-}" ]]; then
    printf '%s\n' "$absolute" >>"$CCC_BZIP2_SOURCE_LOG"
  fi
}

run_ccc() {
  local target_arguments=("--target=$CCC_BZIP2_TARGET")
  if [[ "$CCC_BZIP2_TARGET" == aarch64-apple-darwin ]]; then
    target_arguments+=(
      -isysroot "$CCC_BZIP2_SDKROOT"
      "-mmacosx-version-min=$CCC_BZIP2_DEPLOYMENT_TARGET"
    )
  else
    target_arguments+=("--sysroot=$CCC_BZIP2_SYSROOT")
  fi
  log_command ccc "$CCC" -resource-dir "$CCC_RESOURCE_DIR" \
    "${target_arguments[@]}" "$@"
  "$CCC" -resource-dir "$CCC_RESOURCE_DIR" \
    "${target_arguments[@]}" "$@"
}

run_linker() {
  local target_arguments=()
  if [[ "$CCC_BZIP2_TARGET" == aarch64-apple-darwin ]]; then
    target_arguments+=(
      -isysroot "$CCC_BZIP2_SDKROOT"
      "-mmacosx-version-min=$CCC_BZIP2_DEPLOYMENT_TARGET"
    )
  else
    target_arguments+=("--sysroot=$CCC_BZIP2_SYSROOT")
  fi
  log_command link "$CCC_LINK_CC" "${target_arguments[@]}" "$@"
  "$CCC_LINK_CC" "${target_arguments[@]}" "$@"
}

arguments=("$@")
sources=()
compile_arguments=()
output=
compile_only=false
frontend_only=false

for ((index = 0; index < ${#arguments[@]}; index++)); do
  argument=${arguments[index]}
  case "$argument" in
    *.c)
      sources+=("$argument")
      ;;
    -o)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: -o requires an argument" >&2
        exit 2
      fi
      output=${arguments[index + 1]}
      ((index += 1))
      ;;
    -c)
      compile_only=true
      ;;
    -std=c99 | -std=gnu99 | -std=gnu11)
      # CCC's default GNU C11 mode is the supported superset.
      ;;
    -E | -M | -MM | --dump-* | --emit=*)
      frontend_only=true
      compile_arguments+=("$argument")
      ;;
    -fPIE | -fpie | -fno-PIE | -fno-pie | -fno-PIC | -fno-pic | \
      -pie | --pie | -no-pie | --no-pie | -nopie)
      # Exercise CCC's platform-default relocation policy.
      ;;
    -l?* | -L?* | -Wl,* | -Wl=* | -Xlinker=*)
      ;;
    -l | -L | -Xlinker)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: $argument requires an argument" >&2
        exit 2
      fi
      ((index += 1))
      ;;
    *.o | *.a | *.so | *.lo)
      ;;
    *.s | *.S | *.asm)
      echo "ccc-cc: assembly input is outside the selected bzip2 C surface: $argument" >&2
      exit 2
      ;;
    *.i | *.ii)
      echo "ccc-cc: preprocessed source input is unsupported and will not be delegated: $argument" >&2
      exit 2
      ;;
    *.cc | *.cp | *.cpp | *.cxx | *.C | *.m | *.mm)
      echo "ccc-cc: non-C source input is outside the selected bzip2 C surface: $argument" >&2
      exit 2
      ;;
    -S)
      echo "ccc-cc: assembly output is outside the selected bzip2 C surface" >&2
      exit 2
      ;;
    -x)
      echo "ccc-cc: explicit language selection is unsupported and will not be delegated" >&2
      exit 2
      ;;
    @*)
      echo "ccc-cc: response files are unsupported because their C inputs cannot be audited" >&2
      exit 2
      ;;
    *)
      compile_arguments+=("$argument")
      ;;
  esac
done

unresolved_link_arguments=()
for ((index = 0; index < ${#arguments[@]}; index++)); do
  argument=${arguments[index]}
  case "$argument" in
    -std=*)
      ;;
    -Xlinker)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "ccc-cc: -Xlinker requires an argument" >&2
        exit 2
      fi
      linker_argument=${arguments[index + 1]}
      if ! linker_token_overrides_default_pie "$linker_argument"; then
        unresolved_link_arguments+=("$argument" "$linker_argument")
      fi
      ((index += 1))
      ;;
    *)
      if filtered_argument=$(filter_default_pie_driver_argument "$argument"); then
        unresolved_link_arguments+=("$filtered_argument")
      fi
      ;;
  esac
done

if ((${#sources[@]} == 0)); then
  if ((${#arguments[@]} == 1)) && [[ "${arguments[0]}" == "--version" ]]; then
    printf 'ccc bzip2 corpus adapter (C translation by %s; linking by %s)\n' \
      "$CCC" "$CCC_LINK_CC"
    exit 0
  fi
  run_linker "${unresolved_link_arguments[@]}"
  exit $?
fi

if $frontend_only; then
  if ((${#sources[@]} != 1)); then
    echo "ccc-cc: frontend-only actions require exactly one C source" >&2
    exit 2
  fi
  run_ccc "${arguments[@]}"
  exit $?
fi

if $compile_only && [[ -n "$output" ]]; then
  if ((${#sources[@]} != 1)); then
    echo "ccc-cc: -o with -c requires exactly one C source" >&2
    exit 2
  fi
fi

object_directory=
if ! $compile_only; then
  object_directory=$(mktemp -d "${TMPDIR:-/tmp}/ccc-bzip2-objects.XXXXXX")
  cleanup_object_directory() {
    if [[ -n "$object_directory" ]] && [[ -d "$object_directory" ]]; then
      rm -rf -- "$object_directory"
    fi
  }
  trap cleanup_object_directory EXIT
fi
objects=()

for ((index = 0; index < ${#sources[@]}; index++)); do
  source=${sources[index]}
  record_source "$source"
  if $compile_only; then
    if [[ -n "$output" ]]; then
      object=$output
    else
      object=$(basename "${source%.c}.o")
    fi
  else
    object="$object_directory/$index.o"
  fi
  if ((${#compile_arguments[@]})); then
    run_ccc "${compile_arguments[@]}" -c "$source" -o "$object"
  else
    run_ccc -c "$source" -o "$object"
  fi
  objects+=("$object")
done

if $compile_only; then
  exit 0
fi

link_arguments=()
source_index=0
for argument in "${unresolved_link_arguments[@]}"; do
  case "$argument" in
    *.c)
      link_arguments+=("${objects[source_index]}")
      ((source_index += 1))
      ;;
    *)
      link_arguments+=("$argument")
      ;;
  esac
done
run_linker "${link_arguments[@]}"
